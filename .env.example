# Production environment variables for Fly.io

# Required for MongoDB Atlas connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/collabcpp?retryWrites=true&w=majority

# Required for authentication
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
CLIENT_URL=https://your-frontend-host.example

# Optional
PORT=5000
LOG_LEVEL=info
